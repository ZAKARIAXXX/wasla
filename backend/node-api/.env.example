# Server Configuration
PORT=5000

# Database Configuration (Prisma)
# Example: "postgresql://janedoe:mypassword@localhost:5432/mydb?schema=public"
# For local development with SQLite, use a file path relative to the prisma schema file:
DATABASE_URL="file:./dev.db"

# JWT Configuration
# Choose a strong secret for token signing
JWT_SECRET="your_jwt_secret_here"
